{
  "manifest_version": 3,
  "name": "X 贴文转图卡",
  "short_name": "x-to-img",
  "version": "0.6.9",
  "description": "分享旁边出图卡。藏黄推广告、下原图视频、揭开年龄遮罩、整页聚光跟帖。",
  "homepage_url": "https://github.com/icekale/x-to-img",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "X 贴文转图卡",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "permissions": [
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.x.com/*",
        "https://mobile.twitter.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.x.com/*",
        "https://mobile.twitter.com/*"
      ],
      "js": [
        "shim.js",
        "x-to-img.user.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "host_permissions": [
    "https://*.twimg.com/*",
    "https://ton.twitter.com/*"
  ]
}
